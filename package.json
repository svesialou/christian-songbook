{
  "name": "christian-songbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit",
    "test": "node --check scripts/lib/song-category-rules.mjs && node --check scripts/lib/song-slug.mjs && node --check scripts/generate-sw.mjs && node --check scripts/import-legacy-songs.mjs && node --check scripts/generate-staging-submissions-sql.mjs && node --check scripts/extract-notion-songbook.mjs && node --check scripts/generate-bundled-catalog.mjs && node --check scripts/check-search-normalization.mjs && node scripts/check-search-normalization.mjs",
    "seed:legacy:example": "node scripts/import-legacy-songs.mjs --input seed/legacy/songs.example.json",
    "seed:legacy:json": "node scripts/import-legacy-songs.mjs --input seed/legacy/songs.dump.json --out src/data/importedCatalog.generated.json",
    "seed:legacy:sql": "node scripts/import-legacy-songs.mjs --input seed/legacy/songs.dump.json --sql-out migrations/003_legacy_catalog_seed.generated.sql",
    "seed:staging:submissions-sql": "node scripts/generate-staging-submissions-sql.mjs --sql-out seed/holychords/submissions.generated.sql",
    "seed:notion-youth:extract": "node scripts/extract-notion-songbook.mjs --input seed/notion-youth-songbook/songs.staging.json --output seed/notion-youth-songbook/songs.staging.json",
    "seed:notion-youth:bundled-catalog": "node scripts/generate-bundled-catalog.mjs",
    "seed:notion-youth:published-sql": "node scripts/generate-bundled-catalog.mjs --sql-out seed/notion-youth-songbook/catalog.generated.sql",
    "seed:notion-youth:submissions-sql": "node scripts/generate-staging-submissions-sql.mjs --input seed/notion-youth-songbook/songs.staging.json --marker songbook-staging-2026-08-14 --sql-out seed/notion-youth-songbook/submissions.generated.sql",
    "seed:songbook:extract": "npm run seed:notion-youth:extract",
    "seed:songbook:bundled-catalog": "npm run seed:notion-youth:bundled-catalog",
    "seed:songbook:published-sql": "npm run seed:notion-youth:published-sql",
    "seed:songbook:submissions-sql": "npm run seed:notion-youth:submissions-sql",
    "build": "tsc && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.0.38",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.19"
  }
}
